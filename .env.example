# Local mode is always the free UVR workflow and never uses this key.
# Hosted Enhanced requires this key for its bundled AI evidence review.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_AUDIO_MODEL=gpt-audio-1.5

# Each chunk sends synchronized original-mix and isolated-horn audio to OpenAI.
# 60 seconds x 8 chunks permits recordings up to 8 minutes.
OPENAI_AUDIO_CHUNK_SECONDS=60
OPENAI_AUDIO_MAX_CHUNKS=8

# Local UVR-compatible separator settings.
# uvr: local model only. lalal: LALAL API only.
# auto: run the primary, then the other provider only when confidence is low.
# both: always run both and select the stronger transcription candidate.
SEPARATION_PROVIDER=uvr
SEPARATION_PRIMARY=uvr
SEPARATION_QUALITY_THRESHOLD=0.68

# Required only for lalal/auto/both. API v1 uses Phoenix for wind stems.
LALAL_API_KEY=
LALAL_API_BASE_URL=https://www.lalal.ai/api/v1
LALAL_SPLITTER=phoenix
LALAL_EXTRACTION_LEVEL=deep_extraction
LALAL_POLL_SECONDS=4
LALAL_TIMEOUT_SECONDS=1800

UVR_MODEL_NAME=17_HP-Wind_Inst-UVR.pth
# This model's desired secondary stem is Woodwinds; its other stem is No Woodwinds.
UVR_TARGET_STEM=Woodwinds
# Display/export label. The filename is still derived from each uploaded file.
UVR_OUTPUT_LABEL="Wind Inst"
# Leave blank to use .models/audio-separator inside this project.
UVR_MODEL_DIR=
UVR_MODEL_SHA256=acc6d472b4b478da9c9ab5af45b167749e05a7f65b30c7d5988b3700a513aeee
UVR_OUTPUT_FORMAT=WAV
UVR_VR_WINDOW_SIZE=512
UVR_VR_AGGRESSION=5
# Matches the working UVR5 GUI output by restoring the model's missing high frequencies.
UVR_VR_HIGH_END_PROCESS=true
# The reference UVR5 run has GPU Conversion unchecked. Apple Silicon UVR uses
# polyphase resampling on this CPU path.
UVR_FORCE_CPU=true
UVR_RESAMPLER=polyphase

# cpu works everywhere. Set to mps only if the transcription package supports it.
SAX_DEVICE=cpu
MAX_UPLOAD_MB=250
KEEP_JOBS_HOURS=24

WORK_DIR=

# Hosted Cloud Run mode. Leave RUNTIME_MODE=local on your Mac.
RUNTIME_MODE=local
PUBLIC_BASE_URL=
GOOGLE_CLOUD_PROJECT=
GCP_REGION=us-west1
GCP_BUCKET=
GCP_JOB_NAME=saxscribe-worker
FIRESTORE_COLLECTION=saxscribe_jobs
FIRESTORE_PAYMENTS_COLLECTION=saxscribe_payments

# Hosted Enhanced is a one-time Stripe Checkout purchase. Create an active
# one-time Price in Stripe and store only its price_... id here.
STRIPE_ENHANCED_PRICE_ID=
STRIPE_SECRET_KEY=
# Optional for the upload-after-payment MVP; recommended for signed event audit.
STRIPE_WEBHOOK_SECRET=
